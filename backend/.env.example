# 1. Server Settings
ENVIRONMENT=development                # 运行环境: development | staging | production
DEBUG=True                             # 调试模式 (生产环境设为 False)
HOST=0.0.0.0                           # 服务监听地址
PORT=8000                              # FastAPI 服务端口
API_V1_PREFIX=/api                     # API 路由前缀

# 2. CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# 3. Database Settings
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# 生产环境使用 PostgreSQL（在 Railway/Render 等平台替换为此格式）：
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/second_earth_db

# 4. Astronomy APIs
# NASA Exoplanet Archive TAP API 基础 URL
NASA_EXOPLANET_API_URL=https://exoplanetarchive.ipac.caltech.edu/TAP/sync
# MAST (Mikulski Archive for Space Telescopes) API Token
MAST_API_TOKEN=your_mast_token_here

# 5.Paths & Cache
DATA_DIR=./data
RAW_FITS_DIR=./data/fits_raw
PROCESSED_JSON_DIR=./data/processed_json
# 行星列表与光谱内存缓存过期时间 (秒)
PLANET_CACHE_TTL=86400                 # 星表全量数据 24小时
SPECTRA_CACHE_TTL=0                    # 光谱数据永久预缓存 (0 表示不过期)

# 6. Background Sync
ENABLE_BACKGROUND_SYNC=True            # 是否开启 NASA/MAST 定时轮询
SYNC_INTERVAL_HOURS=12                 # 轮询比对收藏行星新数据的间隔 (小时)

# 7. MCP Skill Settings
MCP_SERVER_NAME=exoplanet-spectra-fetcher
MCP_LOG_LEVEL=INFO